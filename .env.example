# Copy to .env and fill in real values. .env is git-ignored — never commit it.
# Consumed by docker-compose.yml (gateway service). The model service takes only
# MODEL_PATH + PORT, both set in compose — no secrets.

# --- Required ---

# HMAC shared secret — must match the secret set on the GitHub webhook.
GITHUB_WEBHOOK_SECRET=change-me

# GitHub token used to fetch diffs and write labels/comments.
# Prefer a fine-grained PAT scoped to the target repos (Pull requests: read/write,
# Issues: read/write) over a classic full-`repo` token.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Base URL of the self-hosted model service. In compose this is the internal
# service name; set it only if you run the model elsewhere.
MODEL_URL=http://sentinel-model:9000

# --- Optional (sensible defaults shown; leave unset to use them) ---

# Minimum model confidence (0–1) required to label + comment. Leave UNSET to
# source the artifact-selected threshold from the model's /healthz (0.95 fallback
# when the model is unreachable). Set it here only to override that.
# CONFIDENCE_THRESHOLD=0.90

# Label applied to flagged PRs. Defaults to needs-human-review.
# SLOP_LABEL=needs-human-review

# Gateway listen port. Defaults to 8080.
# PORT=8080

# Max webhook body size in bytes; oversized deliveries are rejected with 413
# before HMAC/parsing. Defaults to 26214400 (25 MiB).
# MAX_BODY_BYTES=26214400

# Background triage worker-pool size (1–64). Defaults to 8.
# WORKER_COUNT=8
