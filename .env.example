# Copy to .env and fill in real values. .env is git-ignored — never commit it.
# Consumed by docker-compose.yml (gateway service).

# HMAC shared secret — must match the secret set on the GitHub webhook.
GITHUB_WEBHOOK_SECRET=change-me

# GitHub token used to fetch diffs and write labels/comments.
# Prefer a fine-grained PAT scoped to the target repos (Pull requests: read/write,
# Issues: read/write) over a classic full-`repo` token.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Minimum model confidence (0–1) required to label + comment. Defaults to 0.90.
CONFIDENCE_THRESHOLD=0.90

# Label applied to flagged PRs. Defaults to needs-human-review.
SLOP_LABEL=needs-human-review
